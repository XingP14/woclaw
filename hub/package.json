{
  "name": "woclaw-hub",
  "version": "0.5.0",
  "description": "WoClaw Hub - WebSocket relay server for OpenClaw multi-agent communication (Claude Skill Creator 2.0 verifiable / A-B / auto-optimize compatible; 3 test cases under tests/test_hub_skill.json)",
  "main": "dist/index.js",
  "type": "module",
  "keywords": [
    "openclaw",
    "claude-code",
    "woclaw",
    "hub",
    "websocket",
    "relay",
    "shared-memory",
    "agent-skills",
    "claude-skills",
    "anthropic-skills"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "docker:build": "docker build -t xingp14/woclaw-hub .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "mysql2": "^3.14.5",
    "node-cron": "^4.2.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "tests/**/*",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "test/**/*"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XingP14/woclaw.git"
  },
  "bugs": {
    "url": "https://github.com/XingP14/woclaw/issues"
  },
  "homepage": "https://github.com/XingP14/woclaw#readme",
  "author": "XingP14"
}
