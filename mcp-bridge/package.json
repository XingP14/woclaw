{
  "name": "woclaw-mcp",
  "version": "0.1.2",
  "description": "WoClaw MCP Bridge - exposes WoClaw Hub memory and topics as MCP tools. Claude Skill Creator 2.0 verifiable / A-B / auto-optimize compatible; 3 test cases under tests/test_mcp_bridge_skill.json.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "woclaw-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "mkdir -p dist && cp -f src/index.js dist/ && cp -f src/mcp_log.js dist/",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp-server",
    "model-context-protocol",
    "woclaw",
    "woclaw-mcp",
    "agent-tools",
    "claude-desktop",
    "cursor",
    "windsurf",
    "mcphub",
    "agent-skills",
    "claude-skills"
  ],
  "files": [
    "test/**/*",
    "dist/**/*",
    "README.md",
    "SKILL.md",
    "tests/**/*",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XingP14/woclaw.git"
  },
  "bugs": {
