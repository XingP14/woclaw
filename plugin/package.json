{
  "name": "xingp14-woclaw",
  "version": "0.4.3",
  "description": "WoClaw plugin for OpenClaw, connecting agents to WoClaw Hub for shared memory and topic-based multi-agent messaging.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "woclaw": "./bin/woclaw.js"
  },
  "scripts": {
    "start": "node bin/woclaw.js",
    "build": "mkdir -p dist && npx tsc --project tsconfig.build.json && cp -r skills openclaw.plugin.json bin dist/",
    "prepublishOnly": "npm run build",
    "test": "vitest run test/channel.test.ts"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "woclaw",
      "label": "WoClaw",
      "blurb": "Connect to WoClaw Hub for topic-based multi-agent communication."
    }
  },
  "keywords": [
    "openclaw",
    "woclaw",
    "multi-agent",
    "communication",
    "collaboration",
    "agent-skills",
    "claude-skills",
    "anthropic-skills",
    "openclaw-plugin",
    "shared-memory"
  ],
  "license": "MIT",
  "files": [
    "dist/**/*",
    "bin/**/*",
    "skills/**/*",
    "tests/**/*",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/XingP14/woclaw"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2",
    "vitest": "^1.6.1"
  },
  "bugs": {
    "url": "https://github.com/XingP14/woclaw/issues"
  },
  "homepage": "https://github.com/XingP14/woclaw#readme",
  "overrides": {
    "hono": "^4.12.25",
    "protobufjs": "^7.6.3",
    "tar": "^7.5.16",
    "undici": "^8.5.0",
    "ws": "^8.21.0"
  },
  "author": "XingP14"
}
